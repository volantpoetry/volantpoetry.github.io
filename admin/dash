// ===== POEM OF THE WEEK - PERSONALIZED TO AUTHOR =====
async function notifyPoemAuthorAboutPoemOfTheWeek(poemData) {
    try {
        const title = poemData.title || "Untitled";
        
        // Get the actual poem author
        let author = poemData.author || poemData.authorName || null;
        
        if (!author) {
            author = 'Anonymous';
        }
        
        // Generate a slug
        let slug = poemData.slug;
        if (!slug && title) {
            slug = title.toString().toLowerCase().trim()
                .replace(/[\s\_]+/g, "-")
                .replace(/[^a-z0-9\-]/g, "")
                .replace(/\-+/g, "-")
                .replace(/^\-+|\-+$/g, "");
        }
        
        // Find the author by username
        const user = await findUserByUsername(author);
        
        if (user) {
            const userId = user.id;
            const userData = user.data;
            const username = userData.username || author;
            const poemId = poemData.id || null;
            const poemCollection = poemData.source || 'recentPoems';
            
            const authorMessage = `Hello ${username},

We are thrilled to inform you that your poem "${title}" has been selected as the Poem of the Week.

This is a special recognition of your creative work and contribution to the Volant Poetry community. Your poem will be featured on our homepage and highlighted to all our readers this week.

We appreciate your artistic voice and look forward to seeing more of your beautiful work.
Keep writing and inspiring others.

Warm regards,
The Volant Team
reach.volant@gmail.com`;

            await addDoc(collection(db, "notifications"), {
                forUser: userId,
                type: 'announcement',
                fromUser: userId,
                fromUserName: username,
                message: authorMessage,
                poemTitle: title,
                poemId: poemId,
                poemSlug: slug,
                poemCollection: poemCollection,
                isPoemOfWeek: true,
                isAuthorNotification: true,
                timestamp: new Date(),
                read: false
            });
            
            console.log(`✅ Personalized Poem of the Week notification sent to author: ${username}`);
            showToast(`✅ Personalized notification sent to ${username}!`, 'success');
        } else {
            console.log(`❌ Author "${author}" not found. Sending general announcement only.`);
            showToast(`⚠️ Author "${author}" not found. Sending general announcement only.`, 'info');
        }
        
        // Send general announcement to all users (skip the author)
        await notifyAllUsersAboutPoemOfTheWeek(poemData, slug, user?.id);
        
    } catch (err) {
        console.error("❌ Error sending personalized Poem of the Week notification:", err);
        showToast('❌ Error: ' + err.message, 'error');
        await notifyAllUsersAboutPoemOfTheWeek(poemData, null);
    }
}

// ===== POEM OF THE WEEK - GENERAL ANNOUNCEMENT =====
async function notifyAllUsersAboutPoemOfTheWeek(poemData, slug = null, skipUserId = null) {
    try {
        const usersSnapshot = await getDocs(collection(db, "users"));
        if (usersSnapshot.empty) {
            console.log("No users to notify");
            return;
        }
        
        const batch = writeBatch(db);
        const notificationsRef = collection(db, "notifications");
        const title = poemData.title || "Untitled";
        
        // Get the actual poem author
        let poemAuthor = poemData.author || poemData.authorName || 'Anonymous';
        
        const poemId = poemData.id || null;
        const poemCollection = poemData.source || 'recentPoems';
        
        if (!slug && title) {
            slug = title.toString().toLowerCase().trim()
                .replace(/[\s\_]+/g, "-")
                .replace(/[^a-z0-9\-]/g, "")
                .replace(/\-+/g, "-")
                .replace(/^\-+|\-+$/g, "");
        }
        
        const generalMessage = `We are excited to announce that "${title}" by ${poemAuthor} has been selected as our Poem of the Week.

This beautiful piece will be featured on our homepage throughout the week. We invite you to read and celebrate this wonderful work with us.

Share your thoughts in the comments.

Warm regards,
The Volant Team
reach.volant@gmail.com`;
        
        let count = 0;
        for (const userDoc of usersSnapshot.docs) {
            const userId = userDoc.id;
            // Skip the author if they already got a personalized notification
            if (skipUserId && userId === skipUserId) continue;
            
            const userData = userDoc.data();
            const username = userData.username || 'User';
            
            const newNotifRef = doc(notificationsRef);
            batch.set(newNotifRef, {
                forUser: userId,
                type: 'announcement',
                fromUser: userId,
                fromUserName: username,
                message: generalMessage,
                poemTitle: title,
                poemId: poemId,
                poemSlug: slug,
                poemCollection: poemCollection,
                isPoemOfWeek: true,
                isAuthorNotification: false,
                timestamp: new Date(),
                read: false
            });
            count++;
        }
        
        await batch.commit();
        console.log(`✅ Notified ${count} users about Poem of the Week by ${poemAuthor}`);
        showToast(`✅ Notified ${count} users about Poem of the Week!`, 'success');
        
    } catch (err) {
        console.error("❌ Error sending general Poem of the Week notifications:", err);
        showToast('❌ Error: ' + err.message, 'error');
    }
}

