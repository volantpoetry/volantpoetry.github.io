{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/store/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/store1/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "{poem.html,store/details.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "env": {
    "PAYSTACK_COMMISSION": "10",
    "PAYSTACK_FEE_BEARER": "account",
    "MALL_PAYSTACK_COMMISSION": "10"
  },
  "crons": [
    {
      "path": "/api/verify-settlements",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cleanup-notifications",
      "schedule": "0 2 * * *"
    }
  ]
}