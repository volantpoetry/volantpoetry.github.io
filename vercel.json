{
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/shared/about.html",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/shared/about.html",
      "permanent": true
    }
  ]
}
